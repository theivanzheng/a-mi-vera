# ================================================================
# VARIABLES DE ENTORNO — A Mi Vera
# ================================================================
# Este fichero ES seguro para subir a GitHub (no contiene claves reales).
# Para trabajar en local: copia este fichero como .env.local
# y rellena con las claves del proyecto DEV de Supabase.
#
# NUNCA escribas las claves de PROD en .env.local.
# Las claves de PROD van exclusivamente en el panel de Vercel.
# ================================================================

# URL del proyecto Supabase (DEV)
# Ejemplo: https://xyzxyzxyz.supabase.co
VITE_SUPABASE_URL=

# Clave pública anon del proyecto Supabase (DEV)
# Esta clave es segura para el frontend — no concede acceso admin.
# Ejemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=

# ────────────────────────────────────────────────────────────────────────────
# SOLO PARA SCRIPTS LOCALES DE IMPORTACIÓN (scripts/import-products-dev.ts)
# ────────────────────────────────────────────────────────────────────────────
# Clave service_role del proyecto Supabase (DEV).
# Supabase Dashboard → Project Settings → API → Service role key.
#
# IMPORTANTE:
#   · No tiene prefijo VITE_ → Vite NUNCA la incluirá en el bundle del navegador.
#   · Solo la leen los scripts de Node.js locales (import:dev, import:validate).
#   · Nunca subas esta clave a GitHub ni la pongas en código del frontend.
SUPABASE_SERVICE_ROLE_KEY=
